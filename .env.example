NODE_ENV=production
APP_NAME="Ha Thanh Home"

WEB_URL=https://domain.com
ADMIN_URL=https://admin.domain.com
API_URL=https://api.domain.com

WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=4000

DATABASE_URL="mysql://user:password@127.0.0.1:3306/ha_thanh_home"

JWT_SECRET=
JWT_EXPIRES_IN=7d

UPLOAD_DIR=storage/uploads
PUBLIC_UPLOAD_URL=https://api.domain.com/uploads
WEBP_QUALITY=80
KEEP_ORIGINAL_IMAGE=false
MAX_UPLOAD_SIZE=10485760

# AI provider for article/meta/outline generation (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://modelapi.vn/v1
OPENAI_WIRE_API=chat_completions
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=high
OPENAI_MAX_TOKENS=4096

# Official OpenAI Images API, separate key from article provider
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

GEMINI_API_KEY=
IMAGE_PROVIDER=openai

CORS_ORIGIN=https://domain.com,https://admin.domain.com

DEFAULT_ADMIN_EMAIL=admin@hathanhhome.vn
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
