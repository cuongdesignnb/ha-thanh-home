NODE_ENV=production
APP_NAME="Ha Thanh Home"

# --- Internal container ports ---
WEB_PORT=31873
ADMIN_PORT=31874
API_PORT=31875
MYSQL_HOST_PORT=31906

# --- Public URLs ---
# DEV (localhost) — giữ nguyên các giá trị bên dưới.
# PROD (aaPanel reverse proxy 1 domain):
#   WEB_URL=https://hathanh.cuongdesign.net
#   ADMIN_URL=https://hathanh.cuongdesign.net/admin
#   API_URL=https://hathanh.cuongdesign.net/api
#   NEXT_PUBLIC_WEB_URL=https://hathanh.cuongdesign.net
#   NEXT_PUBLIC_API_URL=/api
WEB_URL=http://localhost:31873
ADMIN_URL=http://localhost:31874
API_URL=http://localhost:31875
NEXT_PUBLIC_WEB_URL=http://localhost:31873
NEXT_PUBLIC_API_URL=http://localhost:31875/api
API_INTERNAL_URL=http://api:4000/api

# --- MySQL ---
# DEV: dùng MySQL container (mặc định docker-compose.yml).
# PROD: dùng MySQL của aaPanel host → đổi DATABASE_URL như comment.
MYSQL_DATABASE=ha_thanh_home
MYSQL_USER=hathanh
MYSQL_PASSWORD=hathanh_secure_password
MYSQL_ROOT_PASSWORD=hathanh_root_password
DATABASE_URL=mysql://hathanh:hathanh_secure_password@mysql:3306/ha_thanh_home
# PROD VPS aaPanel (kết nối MySQL ở host qua host-gateway):
# DATABASE_URL=mysql://hathanh:YOUR_PASSWORD@host.docker.internal:3306/hathanh

# --- Auth ---
# Sinh JWT_SECRET random ở prod: openssl rand -base64 48
JWT_SECRET=change-this-long-random-secret-before-production
JWT_EXPIRES_IN=7d

# --- Upload ---
# PROD: PUBLIC_UPLOAD_URL=https://hathanh.cuongdesign.net/uploads
UPLOAD_DIR=storage/uploads
PUBLIC_UPLOAD_URL=http://localhost:31875/uploads
WEBP_QUALITY=80
KEEP_ORIGINAL_IMAGE=false
MAX_UPLOAD_SIZE=10485760

# --- AI (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL_WRITER=
OPENAI_MODEL_FAST=
OPENAI_IMAGE_MODEL=
GEMINI_API_KEY=
IMAGE_PROVIDER=openai

# --- CORS ---
# PROD: CORS_ORIGIN=https://hathanh.cuongdesign.net
CORS_ORIGIN=http://localhost:31873,http://localhost:31874

# --- Admin basePath ---
# DEV: để trống (admin chạy ở root localhost:31874).
# PROD reverse proxy chung 1 domain: ADMIN_BASE_PATH=/admin
ADMIN_BASE_PATH=

# --- Admin mặc định (seed lần đầu) ---
DEFAULT_ADMIN_EMAIL=admin@hathanhhome.vn
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
